#!/usr/bin/env bash
set -e

# Nexus BI Engine - Unified Runner
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

CYAN='\033[0;36m'
PURPLE='\033[0;35m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo -e "${PURPLE}=====================================================${NC}"
echo -e "${PURPLE}         🚀 NEXUS BI ENGINE - LAKEHOUSE 🚀          ${NC}"
echo -e "${PURPLE}=====================================================${NC}"

# Check virtual environment
if [ ! -d ".venv" ]; then
    echo -e "${YELLOW}[!] Python virtual environment not found. Initializing...${NC}"
    uv venv .venv
    uv pip install --python .venv -e .
fi

# Check frontend node_modules
if [ ! -d "frontend/node_modules" ]; then
    echo -e "${YELLOW}[!] Frontend node_modules not found. Installing...${NC}"
    cd frontend && npm install && cd "$ROOT_DIR"
fi

if [ "$1" == "--check" ]; then
    echo -e "${CYAN}[*] Running system checks and smoke tests...${NC}"
    .venv/bin/pytest tests/
    cd frontend && npm run build && cd "$ROOT_DIR"
    echo -e "${GREEN}[✔] All smoke checks passed successfully!${NC}"
    exit 0
fi

echo -e "${CYAN}[*] Starting Backend (FastAPI + DuckDB) & Frontend (Vite + React)...${NC}"

# Cleanup background processes on exit
cleanup() {
    echo -e "\n${YELLOW}[!] Stopping all services...${NC}"
    if [ -n "$BACKEND_PID" ]; then
        kill "$BACKEND_PID" 2>/dev/null || true
    fi
    if [ -n "$FRONTEND_PID" ]; then
        kill "$FRONTEND_PID" 2>/dev/null || true
    fi
    wait 2>/dev/null || true
    echo -e "${GREEN}[✔] Services stopped safely.${NC}"
}
trap cleanup SIGINT SIGTERM EXIT

# Start Backend
.venv/bin/uvicorn src.api.server:app --host 127.0.0.1 --port 8000 --reload &
BACKEND_PID=$!

# Wait briefly for backend to bind
sleep 1

# Start Frontend
cd frontend
npm run dev -- --host 127.0.0.1 --port 3000 &
FRONTEND_PID=$!
cd "$ROOT_DIR"

echo -e "${GREEN}-----------------------------------------------------${NC}"
echo -e "${GREEN}  Nexus BI Engine is running!${NC}"
echo -e "  💻 Frontend:  ${CYAN}http://localhost:3000${NC}"
echo -e "  ⚡ Backend:   ${CYAN}http://localhost:8000${NC}"
echo -e "  📚 API Docs:  ${CYAN}http://localhost:8000/docs${NC}"
echo -e "${GREEN}-----------------------------------------------------${NC}"
echo -e "${YELLOW}Press Ctrl+C to stop all services.${NC}"

# Keep script running
wait "$BACKEND_PID" "$FRONTEND_PID"
